# =============================================================================
# MCP server env vars (used by .mcp.json via ${VAR} expansion)
# Copy this file to .env and set real values, or add these to .claude/settings.local.json
# =============================================================================

# Context7 (library/framework docs)
CONTEXT7_API_KEY=your-context7-api-key

# Docker Hub (image search)
HUB_PAT_TOKEN=your-docker-hub-pat-token
DOCKERHUB_USERNAME=your-dockerhub-username

# n8n (workflow automation)
N8N_API_URL=https://your-instance.app.n8n.cloud
N8N_API_KEY=your-n8n-api-key
